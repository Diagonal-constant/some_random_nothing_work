.env
.env.local
.env.*.local
*.pem
*.key

# ==========================================
# 2. Operating System & Editor Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ==========================================
# 3. Node.js & React Frontend
# ==========================================
# Dependencies (installed fresh in Docker/CI)
frontend/node_modules/
/node_modules/

# Local build outputs (generated by Docker/Vite)
frontend/dist/
frontend/build/

# Logs & Caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
frontend/.vite/

# ==========================================
# 4. Python & FastAPI Backend
# ==========================================
# Byte-code and compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
.venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# 5. Docker Runtime & Local Overrides (OPTIONAL)
# ==========================================
# Ignore local Docker volume data if mounted on host
.dockerdata/

# OPTIONAL: Uncomment if developers maintain personalized local compose files
docker-compose.override.yml