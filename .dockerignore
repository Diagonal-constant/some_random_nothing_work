# Version Control & Git
.git
.gitignore
.github

# OS & Environment Metadata
.DS_Store
Thumbs.db
*.swp
*.tmp

# Environment Files (Keep secrets out of images!)
.env
.env.*
!.env.example

# Documentation & Markdown
*.md
README*
LICENSE

# Node / Frontend Exclusions
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.vite
frontend/node_modules
frontend/dist
frontend/build

# Python / Backend Exclusions
__pycache__
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
backend/venv/
backend/__pycache__

# Docker & CI
docker-compose*.yml
Dockerfile*
.dockerignore

